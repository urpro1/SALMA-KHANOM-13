<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Salma Khanum Rooftop — روفتوب سلمى خانم</title>
<meta name="description" content="كافيه روفتوب فاخر في الزرقاء، الأردن. أجواء مسائية دافئة وطعام مصنوع بشغف. Crafted with Passion, Served with Love." />
<meta name="theme-color" content="#1a1410" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['Tajawal', 'ui-sans-serif', 'system-ui', 'sans-serif'],
        },
        colors: {
          background: 'var(--background)',
          foreground: 'var(--foreground)',
          card: 'var(--card)',
          'card-foreground': 'var(--card-foreground)',
          popover: 'var(--popover)',
          'popover-foreground': 'var(--popover-foreground)',
          primary: 'var(--primary)',
          'primary-foreground': 'var(--primary-foreground)',
          secondary: 'var(--secondary)',
          'secondary-foreground': 'var(--secondary-foreground)',
          muted: 'var(--muted)',
          'muted-foreground': 'var(--muted-foreground)',
          accent: 'var(--accent)',
          'accent-foreground': 'var(--accent-foreground)',
          destructive: 'var(--destructive)',
          border: 'var(--border)',
          input: 'var(--input)',
          ring: 'var(--ring)',
          gold: 'var(--gold)',
          'gold-soft': 'var(--gold-soft)',
        },
      },
    },
  }
</script>
<style>
  :root{
    color-scheme: dark;
    --background: oklch(0.17 0.018 55);
    --foreground: oklch(0.95 0.015 80);
    --card: oklch(0.22 0.02 55);
    --card-foreground: oklch(0.95 0.015 80);
    --popover: oklch(0.2 0.02 55);
    --popover-foreground: oklch(0.95 0.015 80);
    --primary: oklch(0.78 0.13 82);
    --primary-foreground: oklch(0.2 0.02 55);
    --secondary: oklch(0.26 0.022 55);
    --secondary-foreground: oklch(0.95 0.015 80);
    --muted: oklch(0.26 0.02 55);
    --muted-foreground: oklch(0.72 0.03 75);
    --accent: oklch(0.3 0.025 55);
    --accent-foreground: oklch(0.95 0.015 80);
    --destructive: oklch(0.6 0.2 25);
    --border: oklch(1 0 0 / 12%);
    --input: oklch(1 0 0 / 15%);
    --ring: oklch(0.78 0.13 82);
    --gold: oklch(0.78 0.13 82);
    --gold-soft: oklch(0.68 0.16 45);
    --radius: 1rem;
  }
  * { border-color: var(--border); }
  body { background-color: var(--background); color: var(--foreground); font-family: 'Tajawal', ui-sans-serif, system-ui, sans-serif; }
  html { scroll-behavior: smooth; }
  ::-webkit-scrollbar { display: none; }
  .no-scrollbar { scrollbar-width: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }
</style>
</head>
<body class="antialiased">
<main class="relative min-h-screen bg-background">

  <!-- SITE NAV -->
  <header id="site-header" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-5 sm:pt-4">
    <nav id="site-nav" class="mx-auto flex max-w-5xl items-center justify-between rounded-full border px-4 py-2.5 transition-all duration-300 sm:px-5 border-transparent bg-background/20 backdrop-blur-md">
      <a href="#top" class="flex items-center gap-2.5">
        <span class="relative h-9 w-9 overflow-hidden rounded-full bg-[#14100c] ring-1 ring-primary/40 inline-block">
          <img src="data:image/png;base64," alt="شعار سلمى خانم" class="absolute inset-0 h-full w-full object-cover" />
        </span>
        <span class="text-sm font-bold leading-tight text-foreground sm:text-base">سلمى خانم</span>
      </a>

      <div class="hidden items-center gap-1 md:flex">
        <a href="#about" class="rounded-full px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">نبذة</a>
        <a href="#menu" class="rounded-full px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">المنيو</a>
        <a href="#gallery" class="rounded-full px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">المعرض</a>
        <a href="#contact" class="rounded-full px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">تواصل</a>
      </div>

      <a href="#menu" class="hidden rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-transform hover:scale-[1.03] active:scale-95 md:inline-block">شاهد المنيو</a>

      <button type="button" id="menu-toggle" aria-label="فتح القائمة" class="flex h-10 w-10 items-center justify-center rounded-full text-foreground transition-colors hover:bg-accent md:hidden">
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg>
        <svg id="icon-x" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </nav>

    <div id="mobile-menu" class="hidden mx-auto mt-2 max-w-5xl rounded-3xl border border-border bg-background/90 p-2 shadow-xl shadow-black/40 backdrop-blur-xl md:hidden">
      <a href="#about" class="mobile-link block rounded-2xl px-4 py-3 text-base font-medium text-foreground transition-colors hover:bg-accent">نبذة</a>
      <a href="#menu" class="mobile-link block rounded-2xl px-4 py-3 text-base font-medium text-foreground transition-colors hover:bg-accent">المنيو</a>
      <a href="#gallery" class="mobile-link block rounded-2xl px-4 py-3 text-base font-medium text-foreground transition-colors hover:bg-accent">المعرض</a>
      <a href="#contact" class="mobile-link block rounded-2xl px-4 py-3 text-base font-medium text-foreground transition-colors hover:bg-accent">تواصل</a>
      <a href="#menu" class="mobile-link mt-1 block rounded-2xl bg-primary px-4 py-3 text-center text-base font-semibold text-primary-foreground">شاهد المنيو</a>
    </div>
  </header>

  <!-- HERO -->
  <section id="top" class="relative flex min-h-[100svh] items-end overflow-hidden">
    <img src="data:image/jpeg;base64," alt="أجواء روفتوب سلمى خانم المسائية" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/70 to-background/30"></div>

    <div class="relative z-10 mx-auto w-full max-w-5xl px-5 pb-16 pt-32 sm:pb-24">
      <div class="flex flex-col items-center text-center">
        <span class="relative mb-6 h-24 w-24 overflow-hidden rounded-full bg-[#14100c] ring-2 ring-primary/50 sm:h-28 sm:w-28 inline-block">
          <img src="data:image/png;base64," alt="شعار سلمى خانم" class="absolute inset-0 h-full w-full object-cover" />
        </span>

        <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-background/40 px-4 py-1.5 backdrop-blur-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="text-primary"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <span class="text-sm font-medium text-foreground">4.8 من 5 · 356 تقييم</span>
        </div>

        <h1 class="text-balance text-4xl font-extrabold leading-tight text-foreground sm:text-6xl">Salma Khanum Rooftop</h1>
        <p class="mt-3 text-lg font-medium text-primary sm:text-2xl">Elevated Dining — تجربة طعام راقية</p>
        <p class="mt-4 max-w-xl text-pretty text-base leading-relaxed text-muted-foreground sm:text-lg">
          Crafted with Passion, Served with Love — أجواء مسائية دافئة على السطح، وطعام مصنوع بشغف في قلب الزرقاء.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#menu" class="rounded-full bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground transition-transform hover:scale-[1.03] active:scale-95">شاهد المنيو</a>
          <a href="#contact" class="rounded-full border border-border bg-background/40 px-8 py-3.5 text-base font-semibold text-foreground backdrop-blur-md transition-colors hover:bg-accent">تواصل معنا</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-20 sm:py-28">
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
      <div class="relative order-first aspect-[4/5] overflow-hidden rounded-[2rem] ring-1 ring-border md:order-last">
        <img src="data:image/jpeg;base64," alt="طبق فاخر من سلمى خانم" class="absolute inset-0 h-full w-full object-cover" />
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-primary">نبذة عنّا</p>
        <h2 class="mt-3 text-balance text-3xl font-extrabold leading-tight text-foreground sm:text-4xl">روفتوب يجمع الدفء بالفخامة</h2>
        <p class="mt-5 text-pretty text-base leading-relaxed text-muted-foreground sm:text-lg">
          في سلمى خانم روفتوب، نصنع لكم تجربة مسائية استثنائية فوق أسطح الزرقاء. إضاءة دافئة،
          جلسات أنيقة وحميمية، وأطباق محضّرة بشغف من مكوّنات نقية. مكان صُنع ليجمع الأحبّة حول
          طاولة واحدة.
        </p>

        <div class="mt-8 space-y-3">
          <div class="rounded-2xl border border-border bg-card p-4 text-card-foreground shadow-sm shadow-black/20">
            <span class="font-medium text-primary">Less is More — Pure ingredients, Bold flavor</span>
          </div>
          <div class="rounded-2xl border border-border bg-card p-4 text-card-foreground shadow-sm shadow-black/20">
            <span class="font-medium text-primary">Made to Share — Good food, fewer strangers</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MENU -->
  <section id="menu" class="scroll-mt-24 px-5 py-20 sm:py-28">
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary">قائمتنا</p>
        <h2 class="mt-3 text-balance text-3xl font-extrabold leading-tight text-foreground sm:text-4xl">المنيو الكامل</h2>
        <p class="mt-3 text-muted-foreground">الأسعار بالدينار الأردني (JOD)</p>
      </div>

      <div class="sticky top-[76px] z-30 mt-8">
        <div class="rounded-full border border-border bg-background/70 p-1.5 backdrop-blur-xl shadow-lg shadow-black/30">
          <div id="menu-tabs" class="flex gap-1 overflow-x-auto no-scrollbar"></div>
        </div>
      </div>

      <div id="menu-items" class="mt-8 grid gap-3 sm:grid-cols-2"></div>
    </div>
  </section>

  <!-- GALLERY -->
  <section id="gallery" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-20 sm:py-28">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">المعرض</p>
      <h2 class="mt-3 text-balance text-3xl font-extrabold leading-tight text-foreground sm:text-4xl">لمحات من أجوائنا</h2>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3">
      <div class="group relative overflow-hidden rounded-[1.5rem] ring-1 ring-border col-span-2 aspect-[16/10] md:col-span-1 md:aspect-square">
        <img src="data:image/jpeg;base64," alt="برغر فاخر" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
      <div class="group relative overflow-hidden rounded-[1.5rem] ring-1 ring-border aspect-square">
        <img src="data:image/jpeg;base64," alt="آيس لاتيه" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
      <div class="group relative overflow-hidden rounded-[1.5rem] ring-1 ring-border aspect-square">
        <img src="data:image/jpeg;base64," alt="بيتزا مارغريتا" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
      <div class="group relative overflow-hidden rounded-[1.5rem] ring-1 ring-border aspect-square">
        <img src="data:image/jpeg;base64," alt="جلسات الروفتوب المسائية" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
      <div class="group relative overflow-hidden rounded-[1.5rem] ring-1 ring-border aspect-square">
        <img src="data:image/jpeg;base64," alt="حلى البراونيز" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
      <div class="group relative overflow-hidden rounded-[1.5rem] ring-1 ring-border aspect-square">
        <img src="data:image/jpeg;base64," alt="موهيتو منعش" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-20 sm:py-28">
    <div class="rounded-[2.5rem] border border-border bg-card p-6 text-card-foreground shadow-xl shadow-black/30 sm:p-10">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary">تواصل معنا</p>
        <h2 class="mt-3 text-balance text-3xl font-extrabold leading-tight text-foreground sm:text-4xl">زورونا على السطح</h2>
        <p class="mt-3 text-pretty text-muted-foreground">Made to Share — نراكم مساءً حول طاولة واحدة.</p>
      </div>

      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        <a href="tel:0795087392" class="block">
          <div class="flex items-center gap-4 rounded-2xl border border-border bg-secondary/50 p-4 transition-colors hover:border-primary/40">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </span>
            <div class="min-w-0">
              <p class="text-sm text-muted-foreground">الهاتف</p>
              <p class="truncate font-semibold text-foreground">0795087392</p>
            </div>
          </div>
        </a>
        <a href="https://www.google.com/maps/search/?api=1&query=Salma+Khanum+Rooftop+Ma%27soum+Circle+Zarqa+Jordan" target="_blank" rel="noopener noreferrer" class="block">
          <div class="flex items-center gap-4 rounded-2xl border border-border bg-secondary/50 p-4 transition-colors hover:border-primary/40">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </span>
            <div class="min-w-0">
              <p class="text-sm text-muted-foreground">العنوان</p>
              <p class="truncate font-semibold text-foreground">منطقة د. معصوم، الزرقاء، الأردن</p>
            </div>
          </div>
        </a>
        <div>
          <div class="flex items-center gap-4 rounded-2xl border border-border bg-secondary/50 p-4 transition-colors hover:border-primary/40">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </span>
            <div class="min-w-0">
              <p class="text-sm text-muted-foreground">أوقات العمل</p>
              <p class="truncate font-semibold text-foreground">يومياً حتى الساعة 1:00 صباحاً</p>
            </div>
          </div>
        </div>
        <a href="https://instagram.com/salma_khanom__" target="_blank" rel="noopener noreferrer" class="block">
          <div class="flex items-center gap-4 rounded-2xl border border-border bg-secondary/50 p-4 transition-colors hover:border-primary/40">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
            </span>
            <div class="min-w-0">
              <p class="text-sm text-muted-foreground">انستقرام</p>
              <p class="truncate font-semibold text-foreground">salma_khanom__</p>
            </div>
          </div>
        </a>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a href="tel:0795087392" class="rounded-full bg-primary px-8 py-3.5 text-center text-base font-semibold text-primary-foreground transition-transform hover:scale-[1.03] active:scale-95">اتصل الآن</a>
        <a href="https://instagram.com/salma_khanom__" target="_blank" rel="noopener noreferrer" class="rounded-full border border-border bg-background px-8 py-3.5 text-center text-base font-semibold text-foreground transition-colors hover:bg-accent">تابعنا على انستقرام</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t border-border px-5 py-10">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 text-center">
      <span class="relative h-14 w-14 overflow-hidden rounded-full bg-[#14100c] ring-1 ring-primary/40 inline-block">
        <img src="data:image/png;base64," alt="شعار سلمى خانم" class="absolute inset-0 h-full w-full object-cover" />
      </span>
      <p class="text-lg font-bold text-foreground">Salma Khanum Rooftop</p>
      <p class="max-w-md text-pretty text-sm leading-relaxed text-muted-foreground">
        Crafted with Passion, Served with Love — منطقة د. معصوم، الزرقاء، الأردن.
      </p>
      <p class="mt-2 text-xs text-muted-foreground">© <span id="year"></span> سلمى خانم روفتوب. جميع الحقوق محفوظة.</p>
    </div>
  </footer>

</main>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  // Nav scroll effect
  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    if (window.scrollY > 24) {
      nav.className = "mx-auto flex max-w-5xl items-center justify-between rounded-full border px-4 py-2.5 transition-all duration-300 sm:px-5 border-border bg-background/70 shadow-lg shadow-black/30 backdrop-blur-xl";
    } else {
      nav.className = "mx-auto flex max-w-5xl items-center justify-between rounded-full border px-4 py-2.5 transition-all duration-300 sm:px-5 border-transparent bg-background/20 backdrop-blur-md";
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu toggle
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconX = document.getElementById('icon-x');
  let open = false;
  function setOpen(v) {
    open = v;
    mobileMenu.classList.toggle('hidden', !open);
    iconMenu.classList.toggle('hidden', open);
    iconX.classList.toggle('hidden', !open);
    menuToggle.setAttribute('aria-label', open ? 'إغلاق القائمة' : 'فتح القائمة');
    menuToggle.setAttribute('aria-expanded', open);
  }
  menuToggle.addEventListener('click', () => setOpen(!open));
  document.querySelectorAll('.mobile-link').forEach((el) => el.addEventListener('click', () => setOpen(false)));

  // Menu data
  const menu = [
    { id: 'appetizers', title: 'مقبلات', items: [
      { name: 'مكس أجبان', price: 2.25 },
      { name: 'فلافل', price: 1.5, note: 'من فرن سلمى خانم' },
      { name: 'جبنة بيضاء', price: 1.5 },
      { name: 'لبنة', price: 1.5 },
      { name: 'تيركي', price: 1.95 },
      { name: 'طبلية سلمى خانم', price: 8 },
      { name: 'حمص', price: 1.5 },
      { name: 'صحن خضار', price: 1 },
      { name: 'زبدة ومربى', price: 1.5 },
      { name: 'فلافل (حبة)', price: 1 },
    ]},
