  const tabsEl = document.getElementById('menu-tabs');
  const itemsEl = document.getElementById('menu-items');
  let active = menu[0].id;

  function renderTabs() {
    tabsEl.innerHTML = '';
    menu.forEach((c) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = c.title;
      btn.className = `shrink-0 whitespace-nowrap rounded-full px-4 py-2 text-sm font-medium transition-all duration-200 ${
        active === c.id ? 'bg-primary text-primary-foreground shadow' : 'text-muted-foreground hover:text-foreground'
      }`;
      btn.addEventListener('click', () => {
        active = c.id;
        renderTabs();
        renderItems();
      });
      tabsEl.appendChild(btn);
    });
  }

  function renderItems() {
    const category = menu.find((c) => c.id === active) ?? menu[0];
    itemsEl.innerHTML = '';
    category.items.forEach((item) => {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between gap-4 rounded-2xl border border-border bg-card p-4 text-card-foreground shadow-sm shadow-black/20 transition-colors hover:border-primary/40';
      row.innerHTML = `
        <div class="min-w-0">
          <p class="truncate font-semibold text-foreground">${item.name}</p>
          ${item.note ? `<p class="mt-0.5 text-sm text-muted-foreground">${item.note}</p>` : ''}
        </div>
        <div class="flex shrink-0 items-baseline gap-1 rounded-full bg-secondary px-3 py-1.5">
          <span class="text-base font-bold text-primary">${item.price.toFixed(2)}</span>
          <span class="text-xs font-medium text-muted-foreground">د.أ</span>
        </div>
      `;
      itemsEl.appendChild(row);
    });
  }

  renderTabs();
  renderItems();
</script>
</body>
</html>
